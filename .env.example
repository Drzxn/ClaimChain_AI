# ===========================================================================
# ClaimChain AI - environment template
#
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env
#
# NEVER commit `.env`. It is listed in .gitignore.
# NEVER paste real API keys into source code, tests, or documentation.
# ===========================================================================

# ---------------------------------------------------------------------------
# Google Gemini (LLM)
# Free-tier key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Exa (search / retrieval)
# Key from https://dashboard.exa.ai
# ---------------------------------------------------------------------------
EXA_API_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL - matches the docker-compose.yml service
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://claimchain:claimchain@localhost:5433/claimchain

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# CORS origin of the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Pipeline controls (used from Stage 1 onward; inert in the foundation)
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_MAX_REPAIR_RETRIES=1
MAX_SUBCLAIMS=8
MAX_CANDIDATES_PER_SUBCLAIM=8
PER_CLAIM_TOKEN_BUDGET=60000

# Fixture mode: replay recorded responses instead of calling live APIs.
# Deferred to a later phase; the flag exists so it is not invented ad hoc.
USE_FIXTURES=false
